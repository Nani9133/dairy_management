{
  "doctype": "DocType",
  "name": "Vehicle",
  "module": "Dairy Management",
  "custom": 1,
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "vehicle_name",
      "label": "Vehicle Name",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "vehicle_number",
      "label": "Vehicle Number",
      "fieldtype": "Data"
    },
    {
      "fieldname": "driver",
      "label": "Driver",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "route",
      "label": "Route",
      "fieldtype": "Link",
      "options": "Dairy Route"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Active\nInactive",
      "default": "Active"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ]
}